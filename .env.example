# Kavenegar SMS (keep secrets only in host environment settings)
KAVENEGAR_API_KEY=replace_with_real_private_api_key
KAVENEGAR_SENDER=

# Generate independent random secrets of at least 32 characters
OTP_PEPPER=replace_with_random_secret_minimum_32_chars
VENOM_ADMIN_KEY=replace_with_different_random_admin_key_minimum_32_chars
# Creator phone in international format, e.g. +98912xxxxxxx
VENOM_CREATOR_PHONE=

VENOM_DEV_OTP=0
OTP_TTL_SECONDS=300
HOST=0.0.0.0
PORT=5000
# Use persistent storage on your hosting provider, e.g. /var/data/venom.sqlite3
VENOM_DB_PATH=./data/venom.sqlite3
